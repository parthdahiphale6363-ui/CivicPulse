# Environment variables (copy this to .env and fill in values)
GROQ_API_KEY=your_groq_api_key_here
SECRET_KEY=generate-a-random-secret-key
GNEWS_API_KEY=your_gnews_api_key_here
SUPABASE_DB_URL=postgresql+psycopg://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Set RAG_ENABLED=1 to enable verified knowledge base retrieval, default is 0 (disabled)
RAG_ENABLED=0

